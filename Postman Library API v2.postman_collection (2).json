    {
      "name": "get book by id",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// simple, non-blocking check",
              "const bookId = pm.collectionVariables.get(\"id\") || pm.environment.get(\"id\");",
              "if (!bookId) {",
              "  console.warn(\"Warning: collection variable 'id' is not set. Proceeding without validation.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test for successful response",
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200,404]);",
              "});",
              "",
              "pm.test(\"Content-Type header is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
