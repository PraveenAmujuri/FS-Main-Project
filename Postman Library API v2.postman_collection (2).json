    {
      "name": "add a book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  const json = pm.response.json();",
              "  if (json && json.id) {",
              "    pm.collectionVariables.set(\"id\", json.id);",
              "    console.log(\"Saved collection variable id =\", json.id);",
              "  } else {",
              "    console.log(\"add a book response did not include id:\", json);",
              "  }",
              "} catch (e) {",
              "  console.log(\"add a book Tests script error:\", e);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
