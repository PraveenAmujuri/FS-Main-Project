		{
			"name": "get book by id",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// ============================================",
							"// Pre-Request Script: Book ID Validation",
							"// ============================================",
							"// This script validates the book ID variable before making the API request",
							"// and provides detailed logging for debugging purposes.",
							"",
							"console.log(\"=== Starting Pre-Request Validation ===\");",
							"console.log(`Request: ${pm.info.requestName}`);",
							"console.log(`Timestamp: ${new Date().toISOString()}`);",
							"",
							"try {",
							"    // Step 1: Retrieve the book ID variable",
							"    console.log(\"\\n[Step 1] Retrieving book ID variable...\");",
							"    const bookId = pm.variables.get(\"id\");",
							"    ",
							"    // Log all available scopes for debugging",
							"    console.log(\"Variable scopes check:\");",
							"    console.log(`  - Collection variable 'id': ${pm.collectionVariables.get(\"id\") || \"not set\"}`);",
							"    console.log(`  - Environment variable 'id': ${pm.environment.get(\"id\") || \"not set\"}`);",
							"    console.log(`  - Global variable 'id': ${pm.globals.get(\"id\") || \"not set\"}`);",
							"    console.log(`  - Resolved variable 'id': ${bookId || \"not set\"}`);",
							"    ",
							"    // Step 2: Check if book ID exists",
							"    console.log(\"\\n[Step 2] Validating book ID existence...\");",
							"    if (!bookId) {",
							"        console.error(\"❌ VALIDATION FAILED: Book ID is not set\");",
							"        console.error(\"Please set the 'id' variable in one of the following scopes:\");",
							"        console.error(\"  - Collection variables\");",
							"        console.error(\"  - Environment variables\");",
							"        console.error(\"  - Global variables\");",
							"        throw new Error(\"Book ID variable 'id' is required but not set.\");",
							"    }",
							"    console.log(\"✓ Book ID exists\");",
							"    ",
							"    // Step 3: Check for empty or whitespace-only values",
							"    console.log(\"\\n[Step 3] Checking for empty or whitespace values...\");",
							"    if (typeof bookId === 'string' && bookId.trim() === '') {",
							"        console.error(\"❌ VALIDATION FAILED: Book ID is empty or contains only whitespace\");",
							"        console.error(`Received value: \"${bookId}\"`);",
							"        throw new Error(\"Book ID cannot be empty or contain only whitespace.\");",
							"    }",
							"    console.log(\"✓ Book ID is not empty\");",
							"    ",
							"    // Step 4: Validate UUID format",
							"    console.log(\"\\n[Step 4] Validating UUID format...\");",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    ",
							"    console.log(`Book ID value: \"${bookId}\"`);",
							"    console.log(`Book ID type: ${typeof bookId}`);",
							"    console.log(`Book ID length: ${bookId.length}`);",
							"    ",
							"    if (!uuidRegex.test(bookId)) {",
							"        console.error(\"❌ VALIDATION FAILED: Invalid UUID format\");",
							"        console.error(`Received: \"${bookId}\"`);",
							"        console.error(\"Expected format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\");",
							"        console.error(\"Where x is a hexadecimal digit (0-9, a-f)\");",
							"        console.error(\"\\nExample valid UUID: 29cd820f-82f9-4b45-a7f4-0924111e5b89\");",
							"        throw new Error(\"Book ID must be a valid UUID format.\");",
							"    }",
							"    console.log(\"✓ UUID format is valid\");",
							"    ",
							"    // Step 5: Final validation summary",
							"    console.log(\"\\n=== Validation Summary ===\");",
							"    console.log(\"✓ All validations passed successfully\");",
							"    console.log(`✓ Validated book ID: ${bookId}`);",
							"    console.log(`✓ Request will proceed to: ${pm.request.url.toString()}`);",
							"    console.log(\"=== Pre-Request Validation Complete ===\\n\");",
							"    ",
							"} catch (error) {",
							"    // Enhanced error handling with detailed logging",
							"    console.error(\"\\n=== VALIDATION ERROR ===\");",
							"    console.error(`Error Type: ${error.name}`);",
							"    console.error(`Error Message: ${error.message}`);",
							"    console.error(`Stack Trace: ${error.stack}`);",
							"    console.error(\"\\n🛑 Request execution stopped due to validation failure\");",
							"    console.error(\"=== End of Error Report ===\\n\");",
							"    ",
							"    // Re-throw the error to stop request execution",
							"    throw error;",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for successful response",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test response time",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Handle different error scenarios",
							"if (pm.response.code === 200) {",
							"    pm.test(\"Response has valid book data\", function () {",
							"        const jsonData = pm.response.json();",
							"        pm.expect(jsonData).to.be.an('object');",
							"        pm.expect(jsonData).to.have.property('id');",
							"        pm.expect(jsonData).to.have.property('title');",
							"    });",
							"    ",
							"    pm.test(\"Book ID matches requested ID\", function () {",
							"        const jsonData = pm.response.json();",
							"        const requestedId = pm.variables.get(\"id\");",
							"        pm.expect(jsonData.id).to.eql(requestedId);",
							"    });",
							"} else if (pm.response.code === 404) {",
							"    pm.test(\"Book not found - valid error response\", function () {",
							"        const jsonData = pm.response.json();",
							"        pm.expect(jsonData).to.have.property('error');",
							"        console.log(\"Book not found with the provided ID\");",
							"    });",
							"} else if (pm.response.code === 400) {",
							"    pm.test(\"Bad request - invalid ID format\", function () {",
							"        const jsonData = pm.response.json();",
							"        pm.expect(jsonData).to.have.property('error');",
							"        console.log(\"Invalid book ID format provided\");",
							"    });",
							"} else if (pm.response.code === 500) {",
							"    pm.test(\"Server error occurred\", function () {",
							"        console.error(\"Internal server error - the API encountered an issue\");",
							"        pm.expect(pm.response.code).to.equal(500);",
							"    });",
							"} else {",
							"    pm.test(`Unexpected status code: ${pm.response.code}`, function () {",
							"        console.log(`Received unexpected status code: ${pm.response.code}`);",
							"        console.log(\"Response body:\", pm.response.text());",
							"    });",
							"}",
							"",
							"// Validate response headers",
							"pm.test(\"Content-Type header is present\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
